// 🚨 CRUCIAL CONFIGURATION: Tell your app where your Python server lives
const BACKEND_URL = "https://arvindshenoy-safety-beacon-backend.hf.space"; 

let userAccessToken = null;
let selectedFolderId = null;
let broadcastInterval = null;
let mediaRecorder = null;
let videoChunks = [];

// Handle authentication completion
function handleCredentialResponse(response) {
    userAccessToken = response.access_token; 
    
    const statusBox = document.getElementById("auth-status");
    statusBox.innerText = "Connected to Google Client Interface ✅";
    statusBox.style.color = "#10b981";

    // Reveal the folder picker button once authenticated
    document.getElementById("picker-btn").style.display = "block";
}

// Open Google's native Folder Browser and Creator pop-up window
function openGoogleFolderPicker() {
    if (!userAccessToken) {
        alert("Please log in first!");
        return;
    }

    // Configure Picker View to strictly show Folders only
    const view = new google.picker.DocsView(google.picker.ViewId.FOLDERS)
        .setSelectFolderEnabled(true)
        .setMimeTypes('application/vnd.google-apps.folder');

    // Build the popup window structure
    const picker = new google.picker.PickerBuilder()
        .addView(view)
        .setOAuthToken(userAccessToken)
        .setDeveloperKey(GOOGLE_DEVELOPER_KEY) // Authenticates your app configuration permissions
        .setCallback(pickerCallback)
        .build();

    picker.setVisible(true);
}

// Processes the user's folder selection or creation click
function pickerCallback(data) {
    if (data.action === google.picker.Action.PICKED) {
        const doc = data.docs[0];
        selectedFolderId = doc.id; // Extract the pure secure Google ID string
        const folderName = doc.name;

        // Update the screen instantly with a confirmation message
        const folderStatus = document.getElementById("folder-status");
        folderStatus.innerText = `Target Folder Selected: "${folderName}" ✅`;
        folderStatus.style.color = "#34d399";
    }
}

// Main Execution Controller
function triggerEmergencyBroadcast() {
    if (!userAccessToken) {
        alert("CRITICAL ERROR: Please authenticate with Google before launching loops.");
        return;
    }

    const statusDisplay = document.getElementById("broadcast-status");
    statusDisplay.innerText = "🔄 EMERGENCY LOOP INITIALIZED: Transmitting packets to target directory...";
    statusDisplay.style.color = "#ef4444";

    // Loop A: Image sequence transmission every 6 seconds
    broadcastInterval = setInterval(() => {
        captureAndSendSnapshot(selectedFolderId);
    }, 6000);

    // Loop B: Video slice processing every 1 minute
    startBackgroundVideoRecording(selectedFolderId);
}

// Background Canvas Frame Extraction Engine
async function captureAndSendSnapshot(folderId) {
    navigator.geolocation.getCurrentPosition(async (position) => {
        const { latitude, longitude } = position.coords;
        let base64Media = null;
        const videoElement = document.getElementById("live-camera");

        if (videoElement && videoElement.srcObject) {
            const canvas = document.createElement("canvas");
            canvas.width = videoElement.videoWidth || 640;
            canvas.height = videoElement.videoHeight || 480;
            canvas.getContext("2d").drawImage(videoElement, 0, 0);
            base64Media = canvas.toDataURL("image/jpeg", 0.7);
        }

        const payload = {
            access_token: userAccessToken,
            folder_id: folderId || null, // Directly targets selectedFolderId or goes to drive root
            latitude: latitude,
            longitude: longitude,
            media_base64: base64Media,
            media_type: "image/jpeg"
        };

        try {
            await fetch(`${BACKEND_URL}/api/broadcast`, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });
            console.log("Telemetry Image slice logged.");
        } catch (err) {
            console.error(err);
        }
    });
}

// Multi-part Segmented Recording Thread Interface
function startBackgroundVideoRecording(folderId) {
    const videoElement = document.getElementById("live-camera");
    if (!videoElement || !videoElement.srcObject) return;

    const stream = videoElement.srcObject;
    
    setInterval(() => {
        videoChunks = [];
        mediaRecorder = new MediaRecorder(stream, { mimeType: 'video/webm;codecs=vp8' });

        mediaRecorder.ondataavailable = (e) => { if (e.data && e.data.size > 0) videoChunks.push(e.data); };
        mediaRecorder.onstop = async () => {
            const videoBlob = new Blob(videoChunks, { type: 'video/webm' });
            const reader = new FileReader();
            reader.readAsDataURL(videoBlob);
            reader.onloadend = async () => {
                navigator.geolocation.getCurrentPosition(async (pos) => {
                    const payload = {
                        access_token: userAccessToken,
                        folder_id: folderId || null,
                        latitude: pos.coords.latitude,
                        longitude: pos.coords.longitude,
                        media_base64: reader.result,
                        media_type: "video/webm"
                    };
                    try {
                        await fetch(`${BACKEND_URL}/api/broadcast`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
                        console.log("Telemetry Video segment logged.");
                    } catch (e) { console.error(e); }
                });
            };
        };

        mediaRecorder.start();
        setTimeout(() => { if(mediaRecorder.state !== "inactive") mediaRecorder.stop(); }, 15000);
    }, 60000);
}
